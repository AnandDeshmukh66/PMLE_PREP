# Copy to .env and fill in. Never commit .env; production values belong in your host's secret store.

# ---------------------------------------------------------------- Database
# PostgreSQL (Neon) is the single source of truth for all persistent data. The provider is picked from the URL
# prefix (scripts/db.mjs), so set this before `npm install` / `npm run build`, and run `npm run db:generate`
# after changing it. Next.js and scripts/db.mjs let .env.local override .env: never put a file: URL there.
# Neon: DATABASE_URL is the pooled connection string (host contains "-pooler") and is used for queries;
# DIRECT_URL is the direct (non-pooled) one and is used only by migrations. Both come from the Neon console.
# Do not add pgbouncer=true for Neon: it disables prepared statements and made queries noticeably slower here.
# DATABASE_URL="postgresql://USER:PASSWORD@EP-NAME-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15"
# DIRECT_URL="postgresql://USER:PASSWORD@EP-NAME.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15"
# Other providers: DIRECT_URL may be omitted; it then defaults to DATABASE_URL.
# A non-public schema can be selected with &schema=NAME on both URLs (raw SQL in lib/bulk.ts qualifies table
# names with it, because a transaction-mode pooler does not keep the per-session search_path).
# Never pass the production URL to tooling that resets its target: `--shadow-database-url`, TEST_PG_URL or
# `prisma migrate dev/reset`. Use a scratch Neon branch or local PGlite for those.
#
# Local SQLite (tests and deliberate offline work only; it is not synchronised with PostgreSQL). The app refuses a
# file: URL unless ALLOW_SQLITE=true, so it can never silently replace the PostgreSQL database.
# DATABASE_URL="file:../data/pmle.db"
# ALLOW_SQLITE="true"

# ---------------------------------------------------------------- Sign-in
# Comma-separated company email domains allowed to sign in, e.g. "example.com,example.co.uk".
# "*" allows any address. Unset: anyone may sign in during development, nobody in production.
ALLOWED_EMAIL_DOMAINS=""
# Comma-separated emails that may use admin tools (Exam Coverage & Quality, server backups). Being listed is not enough on its own: see ADMIN_ACCESS_CODE.
ADMIN_EMAILS=""
# Shared secret (8+ characters) an admin enters once per session to unlock admin actions ("step-up").
# Unset in production: admin actions are disabled. Unset in development: listed admins are not asked for it.
# Generate one with: openssl rand -base64 24   (keep it in your secret manager, not in git)
ADMIN_ACCESS_CODE=""
# How long an unlocked admin session stays unlocked, in hours (1-24). Default 8.
# ADMIN_ELEVATION_HOURS="8"
# How long a session stays valid without use (sliding expiry). Default 30.
SESSION_TTL_DAYS="30"
# Secure cookies are set automatically for HTTPS requests (x-forwarded-proto) and non-localhost hosts.
# Force with "true"/"false" only if your proxy does not send x-forwarded-proto.
# COOKIE_SECURE="true"

# ---------------------------------------------------------------- Exam Coverage & Quality
# Release gate for the admin "Blueprint Distribution Alignment" score: "<versionId>=<w1>,<w2>,...", one entry per
# content version, separated by ";". Each list is that version's stored exam-domain weights (ordered by domain
# number) after they passed `npx tsx scripts/verify-exam-weights.ts --live` against the official guide. The score is
# shown only when the stored weights equal the entry exactly; unset or different, it reads "unavailable".
# BLUEPRINT_VERIFIED_WEIGHTS="ver_example_2026=10,20,30,40"

# ---------------------------------------------------------------- Server backups (disaster recovery)
# Where snapshot files go. Default: data/backups. Use a persistent volume in production.
# BACKUP_DIR="/var/lib/pmle/backups"
# Automatic snapshot interval in hours; 0 disables. Default 24 for SQLite, 0 for PostgreSQL
# (rely on the provider's backups / point-in-time recovery; pg_dump must be installed to enable).
# BACKUP_INTERVAL_HOURS="24"
# Always keep the newest N snapshots; older ones are deleted once past the retention age.
# BACKUP_KEEP="14"
# BACKUP_RETENTION_DAYS="30"

# ---------------------------------------------------------------- Offline tooling
# Python with PyMuPDF, used by scripts/verify-exam-weights.ts to read the official exam guide PDF. Default: python3.
# Use an absolute path to the virtualenv's python. Example: /path/to/.venv/bin/python
# INGEST_PYTHON="python3"
