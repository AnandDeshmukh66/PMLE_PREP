# Copy to .env and fill in. Never commit .env; production values belong in your host's secret store.

# ---------------------------------------------------------------- Database
# Local development: a SQLite file (path is relative to prisma/schema.prisma).
DATABASE_URL="file:../data/pmle.db"
# Production: a managed PostgreSQL database. The provider is picked from the URL prefix
# (scripts/db.mjs), so set this before `npm install` / `npm run build` on the server.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Behind a transaction-mode pooler (PgBouncer, Supabase/Neon pooled URL) add: &pgbouncer=true

# ---------------------------------------------------------------- Sign-in
# Comma-separated company email domains allowed to sign in, e.g. "example.com,example.co.uk".
# "*" allows any address. Unset: anyone may sign in during development, nobody in production.
ALLOWED_EMAIL_DOMAINS=""
# Comma-separated emails that may use admin tools (server backups, DB snapshot, data-quality edits).
ADMIN_EMAILS=""
# How long a session stays valid without use (sliding expiry). Default 30.
SESSION_TTL_DAYS="30"
# Secure cookies are set automatically for HTTPS requests (x-forwarded-proto) and non-localhost hosts.
# Force with "true"/"false" only if your proxy does not send x-forwarded-proto.
# COOKIE_SECURE="true"

# ---------------------------------------------------------------- Server backups (disaster recovery)
# Where snapshot files go. Default: data/backups. Use a persistent volume in production.
# BACKUP_DIR="/var/lib/pmle/backups"
# Automatic snapshot interval in hours; 0 disables. Default 24 for SQLite, 0 for PostgreSQL
# (rely on the provider's backups / point-in-time recovery; pg_dump must be installed to enable).
# BACKUP_INTERVAL_HOURS="24"
# Always keep the newest N snapshots; older ones are deleted once past the retention age.
# BACKUP_KEEP="14"
# BACKUP_RETENTION_DAYS="30"
